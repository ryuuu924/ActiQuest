# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE STORAGE CONFIGURATION (Zero-Cost Free Tier for Video Submissions)
# Supabase provides 1GB free storage with 50MB max upload per file
SUPABASE_URL=DEFAULT_EMPTY
SUPABASE_ANON_KEY=DEFAULT_EMPTY
SUPABASE_BUCKET=quest-submissions

# CLOUDFLARE WORKER BRIDGE (Optional secure bridge between Firebase Auth & Supabase)
CLOUDFLARE_WORKER_URL=DEFAULT_EMPTY


