rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the current user is an authorized ActiQuest admin:
    // 1. Has a document in admins/{uid}
    // 2. Has a document in admins/{email}
    // 3. Has role == 'admin' or isAdmin == true in their users/{uid} document
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ))
      );
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admins collection: authenticated users can read; console or existing admins can manage
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Colleges collection: readable by all authenticated users, writable by admins
    match /colleges/{collegeCode} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quests collection: readable by all authenticated users, writable by admins
    match /quests/{questCode} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Classes collection: readable by all authenticated users; students can increment memberCount on signup, admins have full write
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Users collection:
    // - Students can read user profiles (for leaderboards & standings)
    // - Students can create their own profile on signup
    // - Admins can update any user profile (awarding points, badges, approvedCount)
    // - Students can update their own non-restricted profile fields (e.g. name, profile pic)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalPoints', 'badges', 'approvedCount']))
      );
    }

    // Submissions collection:
    // - Students can read their own submissions or approved submissions for standings; Admins can read all submissions for review
    // - Students can submit video proof (Google Drive link / metadata) with initial 'pending' status
    // - Only admins can approve, reject, or assign points and reviewer notes
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid || resource.data.status == 'approved'
      );
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Academic change requests:
    // - Students can submit requests for section/college/program transfers
    // - Admins can review, approve, or reject
    match /academic_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications collection:
    // - Authenticated users can read and manage notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
