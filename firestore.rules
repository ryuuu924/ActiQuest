rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admins collection: only readable by authenticated users, writable only in console
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Colleges collection: readable by all authenticated users, writable only by admins
    match /colleges/{collegeCode} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quests collection: readable by all authenticated users, writable only by admins
    match /quests/{questCode} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Classes collection: readable by everyone, writable only by admins (or server transaction)
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users collection:
    // - Students can read any user (for leaderboard/rankings)
    // - Students can only create their own profile initially
    // - Students CANNOT modify their own totalPoints, streak, badges, or immutable academic profile (college, program, yearLevel, section)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalPoints', 'badges', 'approvedCount', 'college', 'program', 'yearLevel', 'section', 'classId'])
      );
    }

    // Submissions collection:
    // - Students can read their own submissions; Admins can read all submissions
    // - Students can create submissions with initial status == 'pending'
    // - Only admins can update status to 'approved' or 'rejected' with reviewerNote
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

